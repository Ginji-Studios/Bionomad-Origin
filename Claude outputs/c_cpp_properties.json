{
  "configurations": [
    {
      "name": "Arduino UNO (AVR)",
      "includePath": [
        "${workspaceFolder}/arduino/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/**",
        "${env:USERPROFILE}/Documents/Arduino/libraries/**",
        "${env:USERPROFILE}/OneDrive/Documents/Arduino/libraries/**",
        "${env:USERPROFILE}/OneDrive/Documenti/Arduino/libraries/**"
      ],
      "defines": [
        "ARDUINO=10819",
        "ARDUINO_AVR_UNO",
        "ARDUINO_ARCH_AVR",
        "__AVR_ATmega328P__",
        "F_CPU=16000000L"
      ],
      "cStandard": "c11",
      "cppStandard": "c++11",
      "intelliSenseMode": "gcc-x86"
    }
  ],
  "version": 4
}
